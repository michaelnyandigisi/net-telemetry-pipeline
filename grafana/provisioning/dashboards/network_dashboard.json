
{
  "id": null,
  "uid": "network-telemetry",
  "title": "Network Telemetry",
  "tags": ["network", "speedtest"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "title": "Download Speed",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "Telemetry"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, download_speed AS value FROM speedtest_logs WHERE $__timeFilter(timestamp) ORDER BY timestamp",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Upload Speed",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "Telemetry"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, upload_speed AS value FROM speedtest_logs WHERE $__timeFilter(timestamp) ORDER BY timestamp",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Ping and Jitter",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "Telemetry"
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, ping AS \"Ping (ms)\", jitter AS \"Jitter (ms)\" FROM speedtest_logs WHERE $__timeFilter(timestamp) ORDER BY timestamp",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      }
    }
  ]
}
